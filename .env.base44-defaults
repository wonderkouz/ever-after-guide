# Base44 — placeholder pour l'appId (identifiant public de l'app Base44).
# La vraie valeur est fournie via /run/base44/app.env (gérée par la plateforme)
# et surcharge celle-ci. Sans appId, le client Base44 est créé mais les appels
# auth/entités échouent jusqu'à ce que l'appId soit renseigné.
VITE_BASE44_APP_ID=

# URL publique du frontend déployé (ex: https://mon-app.vercel.app).
# Utilisée pour construire le redirect_url du flux "mot de passe oublié".
# Laisser vide en développement local — l'API Base44 utilisera son URL par défaut.
VITE_APP_URL=
